---
import Base from '../layouts/Base.astro';
---

<Base>
  <section class="hero">
    <img src="/avatar.jpeg" alt="Ben Swanson" class="avatar" />
    <div class="hero-text">
      <h1>Ben Swanson</h1>
      <p class="tagline">Software engineer.</p>
    </div>
  </section>
</Base>

<style>
  .hero {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--border);
  }

  .hero-text h1 {
    margin: 0 0 0.25rem;
    font-size: 1.5rem;
  }

  .tagline {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
</style>
